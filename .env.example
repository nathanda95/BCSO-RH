# Backend environment variables
# Discord app credentials
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Guild (server) that users must belong to
DISCORD_GUILD_ID=your_discord_guild_id

# OAuth2 callback URL (backend)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Frontend base URL for redirects and CORS
FRONTEND_URL=http://localhost:5173

# Role mapping (Discord role IDs)
DISCORD_ROLE_ADMIN_ID=your_admin_role_id
DISCORD_ROLE_MOD_ID=your_mod_role_id
DISCORD_ROLE_PREMIUM_ID=your_premium_role_id

# Session secret
SESSION_SECRET=change_me_to_a_long_random_string

# Postgres connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_auth?schema=public

# App env
NODE_ENV=development

# Optional but recommended: 32-byte base64 key for encrypting refresh tokens at rest
# Example: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Frontend env (create frontend/.env with this value)
VITE_API_URL=http://localhost:3000
